# Copy to .env and fill in with your own Turso database's credentials
# (see README "Deploying to Vercel" for how to create one — the free tier
# is plenty for this pilot). Local dev and production use the same database.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token
